// ==========================================
// OFFBOARDING & EXIT MANAGEMENT MODULE (Phase 5.11)
// ==========================================

// Configuration
model ExitPolicy {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String
  policyName       String
  description      String?
  noticePeriodDays Int
  slaConfig        Json? // { clearanceSlaDays, autoApproveEligibility, escalationTarget }
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  requests ExitRequest[]
}

model ExitReason {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String
  code          String
  label         String
  category      String // 'VOLUNTARY', 'INVOLUNTARY', 'RETIREMENT'
  isRegrettable Boolean  @default(false)
  createdAt     DateTime @default(now())

  requests ExitRequest[]
}

model ExitClearanceTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String
  name         String
  departmentId String?  @db.Uuid // e.g., 'IT', 'Finance', 'HR'
  tasks        Json // List of task definitions and SLAs
  createdAt    DateTime @default(now())
}

model ExitChecklistTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String
  name      String
  items     Json // Checklist items for handover
  createdAt DateTime @default(now())
}

// Process
model ExitRequest {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String
  employeeId   String      @db.Uuid
  employee     EmpEmployee @relation("EmployeeExits", fields: [employeeId], references: [id])
  policyId     String      @db.Uuid
  policy       ExitPolicy  @relation(fields: [policyId], references: [id])
  reasonId     String      @db.Uuid
  reason       ExitReason  @relation(fields: [reasonId], references: [id])
  status       String // 'DRAFT', 'SUBMITTED', 'NOTICE_PERIOD', 'KNOWLEDGE_TRANSFER', 'CLEARANCE', 'SETTLEMENT', 'ARCHIVED'
  requestedLwd DateTime // Last working day
  approvedLwd  DateTime?
  workflowId   String?     @db.Uuid // Reference to workflow engine
  submittedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  noticePeriod       ExitNoticePeriod?
  holds              ExitHold[]
  clearances         ExitClearance[]
  knowledgeTransfers ExitKnowledgeTransfer[]
  assetRecoveries    ExitAssetRecovery[]
  settlement         ExitFinalSettlement?
  interview          ExitInterview?
  documents          ExitDocument[]
  timelines          ExitTimeline[]
  snapshot           ExitSnapshot?
  rehireAssessment   ExitRehireAssessment?
}

model ExitNoticePeriod {
  id            String      @id @default(uuid()) @db.Uuid
  requestId     String      @unique @db.Uuid
  request       ExitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requiredDays  Int
  servedDays    Int
  shortfallDays Int         @default(0)
  isWaived      Boolean     @default(false)
  waivedBy      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ExitHold {
  id         String      @id @default(uuid()) @db.Uuid
  requestId  String      @db.Uuid
  request    ExitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reason     String
  appliedBy  String
  appliedAt  DateTime    @default(now())
  releasedAt DateTime?
  releasedBy String?
}

model ExitRehireAssessment {
  id                String      @id @default(uuid()) @db.Uuid
  requestId         String      @unique @db.Uuid
  request           ExitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  eligibility       String // 'ELIGIBLE', 'ELIGIBLE_AFTER_PERIOD', 'NOT_ELIGIBLE'
  reason            String?
  eligibleAfterDate DateTime?
  assessmentBy      String
  assessmentDate    DateTime    @default(now())
}

// Clearances
model ExitClearance {
  id           String      @id @default(uuid()) @db.Uuid
  requestId    String      @db.Uuid
  request      ExitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  departmentId String      @db.Uuid // Resolves to Org Department
  status       String // 'PENDING', 'CLEARED', 'HELD', 'ESCALATED', 'AUTO_CLEARED'
  clearedBy    String?
  clearedAt    DateTime?
  slaDueDate   DateTime?
  comments     String?
  tasks        Json? // Detailed tasks from template
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// Knowledge Transfer
model ExitKnowledgeTransfer {
  id                String      @id @default(uuid()) @db.Uuid
  requestId         String      @db.Uuid
  request           ExitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  successorId       String?     @db.Uuid
  status            String // 'PENDING', 'IN_PROGRESS', 'COMPLETED'
  completionPercent Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tasks ExitHandoverTask[]
}

model ExitHandoverTask {
  id          String                @id @default(uuid()) @db.Uuid
  transferId  String                @db.Uuid
  transfer    ExitKnowledgeTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  description String
  status      String // 'PENDING', 'COMPLETED'
  completedAt DateTime?
}

// Recoveries
model ExitAssetRecovery {
  id                String      @id @default(uuid()) @db.Uuid
  requestId         String      @db.Uuid
  request           ExitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assetAssignmentId String      @db.Uuid // Reference to Asset Module
  status            String // 'PENDING', 'RECOVERED', 'LOST', 'DAMAGED'
  recoveryCost      Float?
  recoveredAt       DateTime?
  recoveredBy       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model ExitFinalSettlement {
  id              String      @id @default(uuid()) @db.Uuid
  requestId       String      @unique @db.Uuid
  request         ExitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  payrollRecordId String?     @db.Uuid // Reference to Payroll Module
  status          String // 'PENDING', 'CALCULATED', 'DISBURSED'
  totalDues       Float       @default(0)
  totalDeductions Float       @default(0)
  netPayable      Float       @default(0)
  disbursedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// Feedback
model ExitInterview {
  id            String      @id @default(uuid()) @db.Uuid
  requestId     String      @unique @db.Uuid
  request       ExitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  interviewerId String?     @db.Uuid
  status        String // 'SCHEDULED', 'COMPLETED', 'SKIPPED'
  scheduledAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  responses ExitInterviewResponse[]
}

model ExitInterviewQuestion {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String
  questionText String
  category     String
  responseType String // 'TEXT', 'RATING', 'MULTIPLE_CHOICE'
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  responses ExitInterviewResponse[]
}

model ExitInterviewResponse {
  id          String                @id @default(uuid()) @db.Uuid
  interviewId String                @db.Uuid
  interview   ExitInterview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionId  String                @db.Uuid
  question    ExitInterviewQuestion @relation(fields: [questionId], references: [id])
  answerValue String
  createdAt   DateTime              @default(now())
}

// Audit & Metadata
model ExitTimeline {
  id          String      @id @default(uuid()) @db.Uuid
  requestId   String      @db.Uuid
  request     ExitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  event       String
  description String?
  actorId     String      @db.Uuid
  createdAt   DateTime    @default(now())
}

model ExitDocument {
  id              String      @id @default(uuid()) @db.Uuid
  requestId       String      @db.Uuid
  request         ExitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  documentType    String // 'EXPERIENCE_LETTER', 'RELIEVING_LETTER', 'SETTLEMENT', 'NO_DUE'
  templateVersion String?
  storageRef      String
  generatedBy     String
  generatedAt     DateTime    @default(now())
}

model ExitSnapshot {
  id           String      @id @default(uuid()) @db.Uuid
  requestId    String      @unique @db.Uuid
  request      ExitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  snapshotData Json // { employee, manager, dept, assets, finalPay, reason, notice, rehire, clearances }
  createdAt    DateTime    @default(now())
}

// ==========================================
// EXPENSE & TRAVEL MANAGEMENT
// ==========================================

model ApprovalTemplate {
  id          String                    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  versions    ApprovalTemplateVersion[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

model ApprovalTemplateVersion {
  id            String           @id @default(uuid()) @db.Uuid
  templateId    String           @db.Uuid
  template      ApprovalTemplate @relation(fields: [templateId], references: [id])
  versionNumber Int
  rulesSnapshot Json
  activeFrom    DateTime
  activeTo      DateTime?
  createdAt     DateTime         @default(now())
}

model ExpenseClaim {
  id                      String                  @id @default(uuid()) @db.Uuid
  employeeId              String                  @db.Uuid
  title                   String
  status                  String                  @default("DRAFT") // DRAFT, SUBMITTED, POLICY_VALIDATION, APPROVAL, FINANCE_APPROVAL, PAYROLL_REIMBURSEMENT, CLOSED
  totalAmount             Decimal                 @db.Decimal(12, 2)
  currencyCode            String
  submittedAt             DateTime?
  policyVersionId         String                  @db.Uuid
  approvalMatrixVersionId String                  @db.Uuid
  items                   ExpenseItem[]
  snapshots               ExpenseSnapshot[]
  riskAssessments         ExpenseRiskAssessment[]
  budgetConsumptions      BudgetConsumption[]
  budgetReservations      BudgetReservation[]
  timeline                ExpenseTimeline[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model ExpenseItem {
  id                     String           @id @default(uuid()) @db.Uuid
  expenseId              String           @db.Uuid
  expense                ExpenseClaim     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  date                   DateTime
  categoryId             String           @db.Uuid
  amount                 Decimal          @db.Decimal(12, 2)
  currencyCode           String
  exchangeRate           Decimal?         @db.Decimal(10, 6)
  exchangeRateProvider   String?
  exchangeRateCapturedAt DateTime?
  baseCurrency           String
  baseAmount             Decimal          @db.Decimal(12, 2)
  description            String?
  receipts               ExpenseReceipt[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

model ExpenseReceipt {
  id               String      @id @default(uuid()) @db.Uuid
  expenseItemId    String      @db.Uuid
  expenseItem      ExpenseItem @relation(fields: [expenseItemId], references: [id], onDelete: Cascade)
  fileUrl          String
  ocrStatus        String      @default("PENDING") // PENDING, PROCESSED, FAILED
  ocrEngine        String?
  ocrVersion       String?
  vendor           String?
  invoiceNumber    String?
  receiptDate      DateTime?
  confidence       Decimal?    @db.Decimal(5, 2)
  recognizedAmount Decimal?    @db.Decimal(12, 2)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model ExpenseSnapshot {
  id                      String       @id @default(uuid()) @db.Uuid
  expenseId               String       @db.Uuid
  expense                 ExpenseClaim @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  policyVersionId         String       @db.Uuid
  approvalMatrixVersionId String       @db.Uuid
  exchangeRates           Json
  budgetAllocation        Json
  reimbursementRef        String?
  riskScore               Decimal?     @db.Decimal(10, 2)
  approvalChain           Json
  createdAt               DateTime     @default(now())
}

model ExpenseRiskAssessment {
  id            String       @id @default(uuid()) @db.Uuid
  expenseId     String       @db.Uuid
  expense       ExpenseClaim @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  riskScore     Decimal      @db.Decimal(10, 2)
  ruleBreakdown Json
  evaluatedAt   DateTime     @default(now())
}

model ExpenseTimeline {
  id          String       @id @default(uuid()) @db.Uuid
  expenseId   String       @db.Uuid
  expense     ExpenseClaim @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  event       String
  description String?
  actorId     String       @db.Uuid
  createdAt   DateTime     @default(now())
}

model ExpenseBudget {
  id           String              @id @default(uuid()) @db.Uuid
  departmentId String              @db.Uuid
  totalAmount  Decimal             @db.Decimal(12, 2)
  currencyCode String
  periodStart  DateTime
  periodEnd    DateTime
  reservations BudgetReservation[]
  consumptions BudgetConsumption[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model BudgetReservation {
  id        String        @id @default(uuid()) @db.Uuid
  budgetId  String        @db.Uuid
  budget    ExpenseBudget @relation(fields: [budgetId], references: [id])
  expenseId String        @db.Uuid
  expense   ExpenseClaim  @relation(fields: [expenseId], references: [id])
  amount    Decimal       @db.Decimal(12, 2)
  status    String        @default("PENDING") // PENDING, CONVERTED, RELEASED
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model BudgetConsumption {
  id         String        @id @default(uuid()) @db.Uuid
  budgetId   String        @db.Uuid
  budget     ExpenseBudget @relation(fields: [budgetId], references: [id])
  expenseId  String        @db.Uuid
  expense    ExpenseClaim  @relation(fields: [expenseId], references: [id])
  amount     Decimal       @db.Decimal(12, 2)
  consumedAt DateTime      @default(now())
}

model CorporateCardStatement {
  id            String                @id @default(uuid()) @db.Uuid
  cardId        String                @db.Uuid
  statementDate DateTime
  totalAmount   Decimal               @db.Decimal(12, 2)
  status        String                @default("PENDING")
  imports       CorporateCardImport[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model CorporateCardImport {
  id           String                     @id @default(uuid()) @db.Uuid
  statementId  String                     @db.Uuid
  statement    CorporateCardStatement     @relation(fields: [statementId], references: [id])
  fileName     String
  importDate   DateTime
  status       String                     @default("PROCESSING")
  totalRecords Int
  processed    Int
  transactions CorporateCardTransaction[]
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
}

model CorporateCardTransaction {
  id              String                       @id @default(uuid()) @db.Uuid
  importId        String                       @db.Uuid
  import          CorporateCardImport          @relation(fields: [importId], references: [id])
  amount          Decimal                      @db.Decimal(12, 2)
  merchant        String
  transactionDate DateTime
  reconciliation  CorporateCardReconciliation?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
}

model CorporateCardReconciliation {
  id            String                   @id @default(uuid()) @db.Uuid
  transactionId String                   @unique @db.Uuid
  transaction   CorporateCardTransaction @relation(fields: [transactionId], references: [id])
  expenseItemId String                   @db.Uuid
  reconciledAt  DateTime                 @default(now())
}

model TravelRequest {
  id            String          @id @default(uuid()) @db.Uuid
  employeeId    String          @db.Uuid
  purpose       String
  destination   String
  startDate     DateTime
  endDate       DateTime
  status        String          @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, ADVANCE_ISSUED, TRAVEL_STARTED, TRAVEL_COMPLETED, EXPENSE_SUBMITTED, SETTLEMENT, CLOSED, ARCHIVED
  advances      TravelAdvance[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  empEmployee   EmpEmployee?    @relation(fields: [empEmployeeId], references: [id])
  empEmployeeId String?         @db.Uuid
}

model TravelAdvance {
  id              String        @id @default(uuid()) @db.Uuid
  travelRequestId String        @db.Uuid
  travelRequest   TravelRequest @relation(fields: [travelRequestId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  currencyCode    String
  issuedAt        DateTime?
  status          String        @default("PENDING") // PENDING, ISSUED, SETTLED
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// =================================================================================
// ATTENDANCE MODULE - PHASE 1 ARCHITECTURE
// =================================================================================

enum AttendanceResult {
  PRESENT
  ABSENT
  HALF_DAY
  PAID_LEAVE
  CASUAL_LEAVE
  COMP_OFF
  LOP
  TRAINING
  BUSINESS_TRAVEL
  HOLIDAY
  WEEKLY_OFF
  SUSPENDED
}

enum MusterWorkflowStatus {
  DRAFT
  ESCALATED
  SUBMITTED
  VALIDATED
  UNDER_REVIEW
  REVIEWED
  LOCKED
  CORRECTION_REQUESTED
  REOPENED
}

enum AttendanceReviewStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum AttendanceCorrectionStatus {
  NONE
  REQUESTED
  PM_RECOMMENDED
  HR_APPROVED
  REOPENED
  CORRECTED
}

enum AttendanceValidationStatus {
  PENDING
  VALID
  EXCEPTION
}

enum AttendanceLockStatus {
  UNLOCKED
  LOCKED
}

enum PunchType {
  IN
  OUT
}

enum PunchSource {
  MANUAL
  BIOMETRIC
  MOBILE
}

enum AttendanceExceptionType {
  MISSING_ATTENDANCE
  DUPLICATE_PUNCH
  SHIFT_VIOLATION
  UNASSIGNED_EMPLOYEE
  WRONG_SITE
  MISSING_CHECKOUT
  HOLIDAY_CONFLICT
  WEEKLY_OFF_CONFLICT
  UNAUTHORIZED_CORRECTION
  LATE_SUBMISSION
  OVERTIME_THRESHOLD
}

enum AttendanceExceptionStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum AttendanceExceptionSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum AttendanceVersionStatus {
  ACTIVE
  SUPERSEDED
}

model DailySiteMuster {
  id               String   @id @default(uuid()) @db.Uuid
  siteId           String   @db.Uuid
  projectId        String   @db.Uuid
  musterDate       DateTime @db.Date
  shiftId          String?  @db.Uuid
  siteClerkId      String?  @db.Uuid
  projectManagerId String?  @db.Uuid

  snapshotId String?         @unique @db.Uuid
  snapshot   MusterSnapshot? @relation(fields: [snapshotId], references: [id])

  // Operational Health KPIs
  employeesExpected    Int                   @default(0)
  attendanceRecorded   Int                   @default(0)
  pendingAttendance    Int                   @default(0)
  completionPercentage Decimal               @default(0) @db.Decimal(5, 2)
  exceptions           AttendanceException[]

  presentCount  Int @default(0)
  absentCount   Int @default(0)
  lateCount     Int @default(0)
  halfDayCount  Int @default(0)
  leaveCount    Int @default(0)
  overtimeCount Int @default(0)

  correctedCount Int @default(0)
  reviewedCount  Int @default(0)
  lockedCount    Int @default(0)

  workflowStatus MusterWorkflowStatus @default(DRAFT)
  createdAt      DateTime             @default(now())
  draftSavedAt   DateTime?
  updatedAt      DateTime             @updatedAt

  attendanceDays    AttendanceDay[]
  musterTimelines   MusterTimeline[]
  attendanceReviews AttendanceReview[]
}

model MusterSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  musterId   String   @db.Uuid
  siteId     String   @db.Uuid
  projectId  String   @db.Uuid
  capturedAt DateTime @default(now())

  // Storing the snapshotted raw data (e.g. employee JSON array with assignments)
  snapshotData Json

  muster DailySiteMuster?
}

model AttendanceDay {
  id       String          @id @default(uuid()) @db.Uuid
  musterId String          @db.Uuid
  muster   DailySiteMuster @relation(fields: [musterId], references: [id], onDelete: Cascade)

  employeeId  String      @db.Uuid
  empEmployee EmpEmployee @relation(fields: [employeeId], references: [id])

  attendanceResult AttendanceResult
  shiftId          String?          @db.Uuid
  version          Int              @default(1)

  // Deep Snapshot Data
  snapshottedDesignation      String?
  snapshottedDepartment       String?
  snapshottedReportingManager String?

  // Extended Metrics & Status
  workedHours      Decimal @default(0) @db.Decimal(5, 2)
  overtimeHours    Decimal @default(0) @db.Decimal(5, 2)
  lateMinutes      Int     @default(0)
  earlyExitMinutes Int     @default(0)

  correctionStatus AttendanceCorrectionStatus @default(NONE)
  validationStatus AttendanceValidationStatus @default(PENDING)
  lockStatus       AttendanceLockStatus       @default(UNLOCKED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions          AttendanceSession[]
  employeeTimelines EmployeeTimeline[]
}

model AttendanceSession {
  id              String        @id @default(uuid()) @db.Uuid
  attendanceDayId String        @db.Uuid
  attendanceDay   AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)

  sessionStart DateTime?
  sessionEnd   DateTime?

  punches AttendancePunch[]
}

model AttendancePunch {
  id        String            @id @default(uuid()) @db.Uuid
  sessionId String            @db.Uuid
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  timestamp DateTime
  punchType PunchType
  source    PunchSource
  createdAt DateTime    @default(now())
}

model AttendanceReview {
  id       String          @id @default(uuid()) @db.Uuid
  musterId String          @db.Uuid
  muster   DailySiteMuster @relation(fields: [musterId], references: [id], onDelete: Cascade)

  reviewerId String                 @db.Uuid
  role       String // HR, COORDINATOR, VC, OWNER
  status     AttendanceReviewStatus @default(PENDING)
  remarks    String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
}

model MusterTimeline {
  id       String          @id @default(uuid()) @db.Uuid
  musterId String          @db.Uuid
  muster   DailySiteMuster @relation(fields: [musterId], references: [id], onDelete: Cascade)

  action        String
  actorId       String?  @db.Uuid
  timestamp     DateTime @default(now())
  reason        String?
  previousState String?
  currentState  String?
  version       Int      @default(1)
  severity      String?
}

model AttendanceException {
  id       String          @id @default(uuid()) @db.Uuid
  musterId String          @db.Uuid
  muster   DailySiteMuster @relation(fields: [musterId], references: [id], onDelete: Cascade)

  attendanceDayId String? @db.Uuid
  employeeId      String? @db.Uuid

  exceptionType AttendanceExceptionType
  severity      AttendanceExceptionSeverity
  priority      Int                         @default(0) // Higher number = higher priority

  description       String
  recommendedAction String?
  detectedBy        String // ID of the detector

  status AttendanceExceptionStatus @default(OPEN)

  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?   @db.Uuid
  resolutionNotes String?
  version         Int       @default(1)
}

model EmployeeTimeline {
  id              String        @id @default(uuid()) @db.Uuid
  attendanceDayId String        @db.Uuid
  attendanceDay   AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)

  fieldChanged  String
  previousValue String?
  currentValue  String?
  reason        String?
  actorId       String?  @db.Uuid
  timestamp     DateTime @default(now())
}

model AttendanceSummary {
  id              String @id @default(uuid()) @db.Uuid
  employeeId      String @db.Uuid
  payrollPeriodId String @db.Uuid

  version       Int      @default(1)
  generatedAt   DateTime @default(now())
  generatedById String?  @db.Uuid

  timeMetrics        Json
  attendanceMetrics  Json
  exceptionMetrics   Json
  leaveSummary       Json
  projectSiteSummary Json
  sourceMusterIds    String[] @db.Uuid
  checksum           String?

  employee      EmpEmployee      @relation(fields: [employeeId], references: [id])
  payrollPeriod PayPayrollPeriod @relation(fields: [payrollPeriodId], references: [id])

  @@map("att_attendance_summaries")
}

// --- Payroll Review & Timeline ---
model PayPayrollReview {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @db.Uuid
  payrollRunId    String @db.Uuid
  stepNumber      Int    @default(1)
  reviewerId      String? @db.Uuid
  roleCode        String
  roleDisplayName String
  status          String @default("PENDING")
  remarks         String?
  reviewedAt      DateTime?
  version         Int @default(1)
  createdAt       DateTime @default(now())

  @@map("pay_payroll_reviews")
}

model PayPayrollTimeline {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @db.Uuid
  payrollRunId  String @db.Uuid
  actor         String
  action        String
  reason        String?
  previousState String?
  currentState  String?
  version       Int @default(1)
  createdAt     DateTime @default(now())

  @@map("pay_payroll_timeline")
}

model PayPayrollWorkflow {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @db.Uuid
  name          String
  version       Int @default(1)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())

  steps PayPayrollWorkflowStep[]

  @@map("pay_payroll_workflows")
}

model PayPayrollWorkflowStep {
  id               String @id @default(uuid()) @db.Uuid
  workflowId       String @db.Uuid
  tenantId         String @db.Uuid
  stepNumber       Int
  roleCode         String
  roleDisplayName  String
  required         Boolean @default(true)
  canApprove       Boolean @default(true)
  canReject        Boolean @default(true)
  canReturn        Boolean @default(true)
  allowParallel    Boolean @default(false)
  minimumApprovals Int @default(1)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  version          Int @default(1)
  
  workflow PayPayrollWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("pay_payroll_workflow_steps")
}

model PayPayrollRunWorkflowSnapshot {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @db.Uuid
  payrollRunId    String @unique @db.Uuid
  workflowId      String @db.Uuid
  workflowVersion Int
  snapshotData    Json
  createdAt       DateTime @default(now())

  @@map("pay_payroll_run_workflow_snapshots")
}
