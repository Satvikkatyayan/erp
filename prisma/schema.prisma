generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MASTER & LOOKUP DOMAIN
// ==========================================

model Country {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  code String @unique
  name String @unique

  states State[]

  @@map("countries")
}

model State {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  code      String
  name      String
  countryId String @db.Uuid

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities  City[]

  @@unique([countryId, code])
  @@map("states")
}

model City {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  name    String
  stateId String @db.Uuid

  state State @relation(fields: [stateId], references: [id], onDelete: Restrict)

  branches Branch[]

  @@map("cities")
}

model Currency {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  code   String @unique
  name   String
  symbol String

  organizations Organization[]

  @@map("currencies")
}

model Language {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  code String @unique
  name String

  @@map("languages")
}

model Holiday {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  name           String
  date           DateTime @db.Date
  organizationId String   @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@map("holidays")
}

// ==========================================
// USER & SECURITY DOMAIN
// ==========================================

model User {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?

  employee        EmpEmployee?      @relation(fields: [empEmployeeId], references: [id])
  userRoles       UserRole[]
  sessions        Session[]
  loginAttempts   LoginAttempt[]
  passwordHistory PasswordHistory[]
  auditLogs       AuditLog[]
  trustedDevices  TrustedDevice[]
  empEmployeeId   String?           @db.Uuid

  @@map("users")
}

model Role {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  name        String  @unique
  description String?

  userRoles   UserRole[]
  permissions RolePermission[]
  dataScopes  RoleDataScope[]

  @@map("roles")
}

model Permission {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  action   String // e.g., 'CREATE', 'READ', 'UPDATE', 'DELETE'
  resource String // e.g., 'EmpEmployee', 'Project'

  rolePermissions RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model RolePermission {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token        String   @unique
  refreshToken String?  @unique
  expiresAt    DateTime
  deviceInfo   String?
  ipAddress    String?

  @@index([userId])
  @@map("sessions")
}

model LoginAttempt {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  userId    String? @db.Uuid
  email     String
  ipAddress String
  success   Boolean
  reason    String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("login_attempts")
}

model PasswordHistory {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  userId       String @db.Uuid
  passwordHash String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_history")
}

// RECRUITMENT DOMAIN
// ==========================================

model JobOpening {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  title          String
  description    String
  status         String // Open, Closed, On Hold
  organizationId String @db.Uuid

  candidates Candidate[]

  @@map("job_openings")
}

model Candidate {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  jobOpeningId String @db.Uuid
  firstName    String
  lastName     String
  email        String
  phone        String
  status       String // Applied, Interviewing, Offered, Rejected, Hired

  jobOpening  JobOpening   @relation(fields: [jobOpeningId], references: [id], onDelete: Restrict)
  interviews  Interview[]
  offerLetter OfferLetter?

  @@map("candidates")
}

model Interview {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  candidateId   String   @db.Uuid
  interviewerId String   @db.Uuid // Should probably link to an EmpEmployee, but avoiding for simplicity, or we can use string for now
  scheduledAt   DateTime
  feedback      String?
  status        String // Scheduled, Completed, Cancelled

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("interviews")
}

model OfferLetter {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  candidateId   String  @unique @db.Uuid
  salaryOffered Decimal @db.Decimal(10, 2)
  status        String // Draft, Sent, Accepted, Declined

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("offer_letters")
}

// ==========================================
// ATTENDANCE & LEAVE DOMAIN
// ==========================================

model Shift {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  organizationId String   @db.Uuid
  name           String
  startTime      DateTime @db.Time
  endTime        DateTime @db.Time

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("shifts")
}

/// @deprecated Use AttAttendancePolicyAssignment and rule models instead
model AttendancePolicy {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  name                    String
  lateThresholdMinutes    Int    @default(15)
  halfDayThresholdMinutes Int    @default(240)

  @@map("attendance_policies")
}

/// @deprecated Use AttAttendanceDay and AttAttendancePunch instead
model AttendanceRecord {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  employeeId String    @db.Uuid
  date       DateTime  @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     String // Present, Absent, Half-Day, Leave, Holiday
  isLocked   Boolean   @default(false)

  employee EmpEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance_records")
}

/// @deprecated Use AttAttendanceLock instead
model AttendanceLock {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  periodStartDate DateTime @db.Date
  periodEndDate   DateTime @db.Date
  lockedById      String   @db.Uuid // User Id who locked

  @@map("attendance_locks")
}

/// @deprecated Use LevLeaveType instead
model LeaveType {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  organizationId String  @db.Uuid
  name           String // Casual, Sick, Privilege
  isPaid         Boolean @default(true)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  @@map("leave_types")
}

/// @deprecated Use LevLeaveBalance instead
model LeaveBalance {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  employeeId  String  @db.Uuid
  leaveTypeId String  @db.Uuid
  year        Int
  totalDays   Decimal @db.Decimal(5, 2)
  usedDays    Decimal @default(0) @db.Decimal(5, 2)

  employee  EmpEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

/// @deprecated Use LevLeaveRequest instead
model LeaveRequest {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  employeeId  String   @db.Uuid
  leaveTypeId String   @db.Uuid
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  status      String // Pending, Approved, Rejected, Cancelled
  reason      String?

  employee  EmpEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType     @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  ledgers   LeaveLedger[]

  @@map("leave_requests")
}

/// @deprecated Use LevLeaveLedger instead
model LeaveLedger {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  leaveRequestId String   @db.Uuid
  date           DateTime @db.Date
  daysDeducted   Decimal  @db.Decimal(4, 2)

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@map("leave_ledgers")
}

// ==========================================
// PAYROLL DOMAIN
// ==========================================

/// @deprecated Use PayPayrollPeriod instead
model PayrollCycle {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isClosed  Boolean  @default(false)

  payslips Payslip[]
  runs     PayrollRun[]

  @@map("payroll_cycles")
}

model SalaryComponent {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  name      String
  type      String // Earning, Deduction
  isTaxable Boolean @default(true)

  structures EmployeeSalaryStructure[]
  items      PayrollItem[]

  @@map("salary_components")
}

model EmployeeSalaryStructure {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  employeeId        String  @db.Uuid
  salaryComponentId String  @db.Uuid
  amount            Decimal @db.Decimal(10, 2)

  employee        EmpEmployee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: Restrict)

  @@unique([employeeId, salaryComponentId])
  @@map("employee_salary_structures")
}

/// @deprecated Use PayPayslip instead
model Payslip {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  employeeId     String  @db.Uuid
  payrollCycleId String  @db.Uuid
  netPay         Decimal @db.Decimal(10, 2)
  status         String // Draft, Approved, Paid

  employee     EmpEmployee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payrollCycle PayrollCycle  @relation(fields: [payrollCycleId], references: [id], onDelete: Restrict)
  items        PayrollItem[]

  @@unique([employeeId, payrollCycleId])
  @@map("payslips")
}

/// @deprecated Use PayPayslipItem instead
model PayrollItem {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  payslipId         String  @db.Uuid
  salaryComponentId String  @db.Uuid
  amount            Decimal @db.Decimal(10, 2)

  payslip         Payslip         @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: Restrict)

  @@map("payroll_items")
}

/// @deprecated Use PayPayrollRun instead
model PayrollRun {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  payrollCycleId String @db.Uuid
  runById        String @db.Uuid // User who triggered
  status         String // Processing, Completed, Failed

  payrollCycle PayrollCycle @relation(fields: [payrollCycleId], references: [id], onDelete: Restrict)

  @@map("payroll_runs")
}

// ==========================================
// PROJECTS & ASSETS DOMAIN
// ==========================================

model Project {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  organizationId String  @db.Uuid
  name           String
  description    String?
  status         String // Planning, Active, Completed, On Hold

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ProjectMember[]

  @@map("projects")
}

model ProjectMember {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  projectId     String @db.Uuid
  employeeId    String @db.Uuid
  roleInProject String

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee EmpEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@map("project_members")
}

// ==========================================
// OPERATIONS (TRAVEL, EXPENSES, HELP DESK)
// ==========================================

model TicketCategory {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  name String @unique

  tickets Ticket[]

  @@map("ticket_categories")
}

model Ticket {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  title       String
  description String
  categoryId  String @db.Uuid
  status      String // Open, In Progress, Resolved, Closed
  priority    String // Low, Medium, High, Critical
  reporterId  String @db.Uuid // Should be User

  category TicketCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  comments TicketComment[]

  @@map("tickets")
}

model TicketComment {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  ticketId String @db.Uuid
  authorId String @db.Uuid // User
  content  String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_comments")
}

// ==========================================
// NOTIFICATIONS & SETTINGS & AUDIT
// ==========================================

model NotificationTemplate {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  code    String @unique
  subject String
  body    String

  @@map("notification_templates")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  userId  String  @db.Uuid // Recipient User
  title   String
  message String
  isRead  Boolean @default(false)

  @@map("notifications")
}

model DashboardPreference {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  userId String @unique @db.Uuid
  layout Json

  @@map("dashboard_preferences")
}

model AuditLog {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  userId    String? @db.Uuid // User who did the action
  action    String
  tableName String
  recordId  String  @db.Uuid
  oldValues Json?
  newValues Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tableName, recordId])
  @@map("audit_logs")
}

// ==========================================
// IAM & ENTERPRISE SECURITY DOMAIN (PHASE 3)
// ==========================================

model Module {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  name        String  @unique
  description String?

  features Feature[]

  @@map("modules")
}

model Feature {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  moduleId String @db.Uuid
  name     String
  key      String @unique // e.g. 'leave.request'

  module       Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  featureFlags FeatureFlag[]

  @@map("features")
}

model FeatureFlag {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?   @db.Uuid
  updatedBy String?   @db.Uuid
  version   Int       @default(1)

  featureId String  @db.Uuid
  isEnabled Boolean @default(true)

